{
  "name": "@jitter/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Jitter markets on Sui.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jitter-fi/jitter-sdk.git"
  },
  "homepage": "https://github.com/jitter-fi/jitter-sdk#readme",
  "bugs": {
    "url": "https://github.com/jitter-fi/jitter-sdk/issues"
  },
  "keywords": [
    "jitter",
    "sui",
    "defi",
    "yield",
    "sdk"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.10",
  "scripts": {
    "clean":     "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build":     "bun run clean && tsc -p tsconfig.json",
    "audit:contract": "node ./scripts/audit-contract-surface.mjs",
    "dev":       "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "codegen":   "node ./scripts/clean-codegen.mjs && sui-ts-codegen generate && node ./scripts/fix-generated-imports.mjs",
    "typecheck": "tsc --noEmit",
    "test":      "bun test src/test",
    "test:integration": "bun test src/test/simulation.test.ts",
    "check": "bun run typecheck && bun run test && bun run build",
    "check:contract": "bun run build && bun run audit:contract",
    "prepublishOnly": "bun run check"
  },
  "dependencies": {
    "@mysten/sui": "^2.14.1"
  },
  "devDependencies": {
    "@mysten/codegen": "^0.8.5",
    "@types/node": "^20",
    "bun-types": "^1.3.10",
    "typescript": "^5"
  }
}
